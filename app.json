{
  "expo": {
    "name": "Ankyr",
    "slug": "Ankyr",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ankyr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cord8570.Ankyr",
      "infoPlist": {
        "NSCameraUsageDescription": "Ankyr needs camera access to capture workout photos.",
        "NSMicrophoneUsageDescription": "Ankyr needs microphone access for video recording."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.cord8570.Ankyr"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ankyr needs camera access to capture workout photos.",
          "microphonePermission": "Ankyr needs microphone access for video recording."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "40fd3a04-a83a-4115-bc24-52125184de5b"
      }
    }
  }
}
